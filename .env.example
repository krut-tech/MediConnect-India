APP_NAME="MediConnect India"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Supabase PostgreSQL (existing project — source of truth) ---
# See config/database.php for the unresolved RLS-connection-architecture
# decision before wiring this up for real. Never use the service_role key
# here — that bypasses Row-Level Security platform-wide.
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_TESTING_DATABASE=

# --- Supabase Auth / Storage ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=

CACHE_STORE=database
CACHE_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Vercel / serverless overrides ---
# Vercel's function filesystem is read-only at runtime except /tmp, which is
# writable but ephemeral (wiped between invocations). The defaults above
# (file cache, file sessions, daily log files, compiled Blade views under
# storage/) all try to write to the deployment bundle and will fail there.
# These are NOT set here — set them as actual Vercel Environment Variables
# for the Preview/Production environment, not by editing this file.
#
# CACHE_STORE=array
#   No disk write. Cache is empty per invocation, which is fine here —
#   nothing in this app currently depends on a cache value surviving
#   between separate requests.
#
# SESSION_DRIVER=cookie
#   Chosen deliberately over "array": VerifySupabaseSession (see
#   app/Http/Middleware/VerifySupabaseSession.php) resolves "who is logged
#   in" entirely from data written into the session at login and read back
#   on every later request. "array" would forget that data as soon as the
#   request ends and immediately log everyone out. "database" would need a
#   new sessions table, which is out of scope without separate approval.
#   "cookie" persists the (encrypted) session in the browser, which works
#   correctly for this app's session-only auth model without touching the
#   database.
#
# LOG_CHANNEL=stderr
#   Vercel captures stdout/stderr as function logs. The "stack"/"daily"
#   defaults try to write storage/logs/laravel.log, which doesn't work here.
#
# VIEW_COMPILED_PATH=/tmp/views
#   Laravel compiles every Blade view to a PHP file under
#   storage/framework/views by default on first render. That directory
#   isn't writable at runtime on Vercel. Redirecting to /tmp avoids a
#   fatal error the very first time any Blade view (including the home
#   page) is rendered. /tmp is ephemeral, so views simply recompile on a
#   cold start — no functional difference to the user.
#
# SESSION_SECURE_COOKIE=true
#   Production on Vercel is HTTPS-only.
