APP_NAME="MediConnect India"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Supabase PostgreSQL (existing project — source of truth) ---
# See config/database.php for the unresolved RLS-connection-architecture
# decision before wiring this up for real. Never use the service_role key
# here — that bypasses Row-Level Security platform-wide.
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_TESTING_DATABASE=

# --- Supabase Auth / Storage ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=

CACHE_STORE=database
CACHE_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
